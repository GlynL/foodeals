{
  "name": "foodeals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A curated food-deals aggregator (learning project for the OpenSpec workflow).",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "foodeals": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "precli": "npm run build",
    "cli": "node dist/cli/index.js",
    "prestart": "npm run build",
    "start": "node dist/http/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --fix",
    "*.{ts,js,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.4.3"
  }
}
